<Window x:Class="Pulau.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulau"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True">
    <!--
        A fixed-size transparent host window. Fully transparent pixels are click-through
        (layered window), so only the pill receives mouse input.
        Window size and the pill's top margin come from IslandPlacement; IslandAnimator drives
        the pill's size, corner radius, clip and content.
    -->
    <Grid>
        <Border x:Name="Pill"
                Width="120"
                Height="32"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource IslandBackground}"
                RenderTransformOrigin="0.5,0"
                AutomationProperties.Name="Pulau island">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" />
                    <TranslateTransform x:Name="PillOffset" />
                </TransformGroup>
            </Border.RenderTransform>
            <Canvas>
                <ContentPresenter x:Name="ContentHost"
                                  Canvas.Top="0"
                                  RenderTransformOrigin="0.5,0.5"
                                  TextElement.FontFamily="{StaticResource IslandFont}"
                                  TextElement.Foreground="{StaticResource IslandPrimaryText}">
                    <ContentPresenter.RenderTransform>
                        <ScaleTransform x:Name="ContentScale" />
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Canvas>
        </Border>
    </Grid>
</Window>
