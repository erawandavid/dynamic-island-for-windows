<UserControl x:Class="Pulau.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Expanded island with no activity (340 × 110): clock and date on the left, battery on the right. -->
    <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding TimeText}" FontSize="38" FontWeight="Light" />
            <TextBlock Margin="1,2,0,0"
                       Text="{Binding DateText}"
                       FontSize="13"
                       Foreground="{StaticResource IslandSecondaryText}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasBattery, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Text="{Binding BatteryText}"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <!-- Battery glyph: body (24 × 13) with the charge level inside, plus the terminal nub. -->
                <Grid Width="27" Height="13" VerticalAlignment="Center">
                    <Border Width="24"
                            HorizontalAlignment="Left"
                            BorderBrush="#E6FFFFFF"
                            BorderThickness="1.2"
                            CornerRadius="3.5"
                            Padding="1.8">
                        <Rectangle HorizontalAlignment="Left"
                                   Width="{Binding BatteryFillWidth}"
                                   Fill="{Binding BatteryFillBrush}"
                                   RadiusX="1.5"
                                   RadiusY="1.5" />
                    </Border>
                    <Border Width="2"
                            Height="5"
                            HorizontalAlignment="Right"
                            Background="#E6FFFFFF"
                            CornerRadius="0,1,1,0" />
                </Grid>
            </StackPanel>
            <TextBlock Margin="0,3,0,0"
                       HorizontalAlignment="Right"
                       Text="{Binding BatteryStatusText}"
                       FontSize="12"
                       Foreground="{StaticResource IslandSecondaryText}" />
        </StackPanel>
    </Grid>
</UserControl>
