<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Pulau.Views">
    <!-- Island look (PLAN.md 3.3). Dark only in v1. -->
    <SolidColorBrush x:Key="IslandBackground" Color="#000000" />
    <SolidColorBrush x:Key="IslandPrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="IslandSecondaryText" Color="#A1A1A1" />
    <SolidColorBrush x:Key="IslandTrack" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="IslandPlaceholder" Color="#2C2C2E" />
    <FontFamily x:Key="IslandFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IslandIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <views:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
    <views:BoolToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />

    <!--
        Round icon buttons inside the island. Not focusable: focusing an element would try to
        activate the island's window and steal focus from the app the user is working in.
    -->
    <Style x:Key="IslandIconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource IslandPrimaryText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
