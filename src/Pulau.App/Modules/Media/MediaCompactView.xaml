<UserControl x:Class="Pulau.Modules.Media.MediaCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pulau.Views.Controls">
    <!-- Compact island while media plays (240 × 34): artwork on the left, equalizer on the right. -->
    <Grid Margin="6,0,13,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="22" Height="22" VerticalAlignment="Center">
            <Border CornerRadius="6"
                    Background="{StaticResource IslandPlaceholder}"
                    Visibility="{Binding NowPlaying.HasArt, Converter={StaticResource VisibleWhenFalse}}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="&#xE8D6;"
                           FontFamily="{StaticResource IslandIconFont}"
                           FontSize="11"
                           Foreground="{StaticResource IslandSecondaryText}" />
            </Border>
            <Border CornerRadius="6"
                    Visibility="{Binding NowPlaying.HasArt, Converter={StaticResource VisibleWhenTrue}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding NowPlaying.Art}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <controls:EqualizerBars Grid.Column="2"
                                VerticalAlignment="Center"
                                IsActive="{Binding NowPlaying.IsPlaying}"
                                BarBrush="{Binding NowPlaying.AccentBrush}" />
    </Grid>
</UserControl>
