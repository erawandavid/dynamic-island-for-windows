<UserControl x:Class="Pulau.Modules.Media.MediaExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pulau.Views.Controls">
    <!--
        Expanded island while media plays (380 × 140):
        artwork, title, artist and source app; the progress bar; previous / play-pause / next.
    -->
    <UserControl.Resources>
        <Style x:Key="ControlIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{StaticResource IslandPrimaryText}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="10" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Artwork, track and source app -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="56" Height="56">
                <Border CornerRadius="12"
                        Background="{StaticResource IslandPlaceholder}"
                        Visibility="{Binding NowPlaying.HasArt, Converter={StaticResource VisibleWhenFalse}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="&#xE8D6;"
                               FontFamily="{StaticResource IslandIconFont}"
                               FontSize="22"
                               Foreground="{StaticResource IslandSecondaryText}" />
                </Border>
                <Border CornerRadius="12"
                        Visibility="{Binding NowPlaying.HasArt, Converter={StaticResource VisibleWhenTrue}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding NowPlaying.Art}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding NowPlaying.Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NowPlaying.Artist}"
                           FontSize="13"
                           Foreground="{StaticResource IslandSecondaryText}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                    <Ellipse Width="6"
                             Height="6"
                             Margin="0,0,5,0"
                             VerticalAlignment="Center"
                             Fill="{Binding NowPlaying.AccentBrush}" />
                    <TextBlock Text="{Binding NowPlaying.SourceName}"
                               FontSize="11"
                               Foreground="{StaticResource IslandSecondaryText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <controls:EqualizerBars Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsActive="{Binding NowPlaying.IsPlaying}"
                                    BarBrush="{Binding NowPlaying.AccentBrush}" />
        </Grid>

        <!-- Progress; hidden when the app doesn't report a track length -->
        <Grid Grid.Row="2" Visibility="{Binding NowPlaying.HasTimeline, Converter={StaticResource VisibleWhenTrue}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="32" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding NowPlaying.PositionText}"
                       FontSize="11"
                       Foreground="{StaticResource IslandSecondaryText}" />
            <Grid Grid.Column="1" Height="4" Margin="8,0" VerticalAlignment="Center">
                <Border Background="{StaticResource IslandTrack}" CornerRadius="2" />
                <Border Background="{Binding NowPlaying.AccentBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding NowPlaying.Progress}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Text="{Binding NowPlaying.DurationText}"
                       FontSize="11"
                       Foreground="{StaticResource IslandSecondaryText}" />
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Style="{StaticResource IslandIconButton}"
                    Command="{Binding NowPlaying.PreviousCommand}"
                    AutomationProperties.Name="Previous track">
                <Path Style="{StaticResource ControlIcon}" Data="M6,5 H8 V19 H6 Z M19,5 V19 L9,12 Z" />
            </Button>
            <Button Margin="20,0"
                    Style="{StaticResource IslandIconButton}"
                    Command="{Binding NowPlaying.PlayPauseCommand}"
                    AutomationProperties.Name="{Binding NowPlaying.PlayPauseLabel}">
                <Grid>
                    <Path Style="{StaticResource ControlIcon}"
                          Data="M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z"
                          Visibility="{Binding NowPlaying.IsPlaying, Converter={StaticResource VisibleWhenTrue}}" />
                    <Path Style="{StaticResource ControlIcon}"
                          Data="M7,5 L19,12 L7,19 Z"
                          Visibility="{Binding NowPlaying.IsPlaying, Converter={StaticResource VisibleWhenFalse}}" />
                </Grid>
            </Button>
            <Button Style="{StaticResource IslandIconButton}"
                    Command="{Binding NowPlaying.NextCommand}"
                    AutomationProperties.Name="Next track">
                <Path Style="{StaticResource ControlIcon}" Data="M5,5 L15,12 L5,19 Z M16,5 H18 V19 H16 Z" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
